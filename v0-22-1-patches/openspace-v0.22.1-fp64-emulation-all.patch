+    glm::mat4 hi;
+    glm::mat4 lo;
+    for (int col = 0; col < 4; ++col) {
+        for (int row = 0; row < 4; ++row) {
+            const double val = m[col][row];
+            const float h = static_cast<float>(val);
+            const float l = static_cast<float>(val - static_cast<double>(h));
+            hi[col][row] = h;
+            lo[col][row] = l;
+        }
+    }
+    return { hi, lo };
