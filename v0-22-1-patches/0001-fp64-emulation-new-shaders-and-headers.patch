+ * CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE  *
+ * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.                                         *
+ ****************************************************************************************/
+
+#version __CONTEXT__
+
+#include "powerscaling/powerscaling_vs.glsl"
+#include "df64.glsl"
+
+const int MaxSpacecraftObservatories = 7;
+
+layout(location = 0) in vec4 in_position;
+layout(location = 1) in vec2 in_st;
+
+out Data {
+  vec4 positionScreenSpace;
+  vec3 texCoords[MaxSpacecraftObservatories];
+} out_data;
+
+uniform mat4 modelViewProjectionTransform;
+uniform bool isCoronaGraph[MaxSpacecraftObservatories];
+uniform bool isEnabled[MaxSpacecraftObservatories];
+uniform mat4 sunToSpacecraftReferenceFrame_hi[MaxSpacecraftObservatories];
+uniform mat4 sunToSpacecraftReferenceFrame_lo[MaxSpacecraftObservatories];
+uniform int numSpacecraftCameraPlanes;
+
+
+void main() {
+  vec4 position = vec4(in_position.xyz, 1.0);
+
+  // Transform the positions to the reference frame of the spacecraft to get tex coords
+  for (int i = 0; i < numSpacecraftCameraPlanes; i++) {
+    out_data.texCoords[i] = vec3(0.0);
+    if (isCoronaGraph[i] || !isEnabled[i])  {
+      continue;
+    };
+    out_data.texCoords[i] = df64_vec4_to_vec4(
+      df64_mat4_mul_vec4(
+        sunToSpacecraftReferenceFrame_hi[i],
+        sunToSpacecraftReferenceFrame_lo[i],
+        position
+      )
+    ).xyz;
+  }
+
+  vec4 positionClipSpace = modelViewProjectionTransform * position;
+  out_data.positionScreenSpace = z_normalization(positionClipSpace);
+  gl_Position = out_data.positionScreenSpace;
+}
diff --git a/modules/space/shaders/constellationlines_vs_float.glsl b/modules/space/shaders/constellationlines_vs_float.glsl
new file mode 100644
index 0000000000..f59e019ba3
