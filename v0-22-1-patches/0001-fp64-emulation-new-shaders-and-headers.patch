+
+# Ensure testsuite package can be imported if this script is executed from anywhere
+runner_dir = Path(__file__).resolve().parent
+sys.path.insert(0, str(runner_dir))
+
+try:
+  from openspace import Api
+except ImportError:
+  Api = None
