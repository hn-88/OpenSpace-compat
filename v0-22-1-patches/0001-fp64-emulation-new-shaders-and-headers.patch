+ * CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE  *
+ * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.                                         *
+ ****************************************************************************************/
+
+#version __CONTEXT__
+
+#extension GL_ARB_shader_storage_buffer_object : require
+
+#include "floatoperations.glsl"
+#include "df64.glsl"
+
+layout (std430, binding = 0) readonly buffer StarData {
+  float allData[];
+};
+
+layout (std430, binding = 1) readonly buffer AdditionalData {
+  int chunkInfo[];
+};
+
+out Data {
+  vec4 gPosition;
+  vec2 brightness;
+  float starDistFromSun;
+  float cameraDistFromSun;
+} out_data;
+
+uniform mat4 model_hi;
+uniform mat4 model_lo;
+uniform mat4 view_hi;
+uniform mat4 view_lo;
+uniform mat4 projection;
+uniform float time;
+uniform int renderOption;
+uniform int maxStarsPerNode;
+uniform int valuesPerStar;
+uniform int nChunksToRender;
+uniform vec2 posXThreshold;
+uniform vec2 posYThreshold;
+uniform vec2 posZThreshold;
+uniform vec2 gMagThreshold;
+uniform vec2 bpRpThreshold;
+uniform vec2 distThreshold;
+
+const int RenderOptionStatic = 0;
+const int RenderOptionColor = 1;
+const int RenderOptionMotion = 2;
+const float Eps = 1e-5;
+const float Parsec = 3.0856776e16;
+
+int findChunkId(int left, int right, int id) {
+  while (left <= right) {
+    int middle = (left + right) / 2;
+    int chunkOffset = middle * 3;
+    int firstStarIdInChunk = chunkInfo[chunkOffset];
+    int nStarsInChunk = chunkInfo[chunkOffset + 1];
+
+    if (id >= firstStarIdInChunk && id < (firstStarIdInChunk + nStarsInChunk)) {
+      return middle;
+    }
+    if (id < firstStarIdInChunk) {
+      right = middle - 1;
+    }
+    else {
+      left = middle + 1;
+    }
+  }
+  return -1;
+}
+
+void main() {
+  int chunkId = findChunkId(0, nChunksToRender - 1, gl_VertexID);
+  if (chunkId < 0) {
+    out_data.gPosition = vec4(0.0);
+    gl_Position = vec4(0.0);
+    return;
+  }
+
+  int chunkOffset = chunkId * 3;
+  int firstStarIdInChunk = chunkInfo[chunkOffset];
+  int nStarsInChunk = chunkInfo[chunkOffset + 1];
+  int firstStarInChunk = chunkInfo[chunkOffset + 2];
+  int placeInChunk = gl_VertexID - firstStarIdInChunk;
+
+  if (nStarsInChunk <= 0) {
+    out_data.gPosition = vec4(0.0);
+    gl_Position = vec4(0.0);
+    return;
+  }
+
+  int idxPos = firstStarInChunk + placeInChunk * 3;
+  vec3 position = vec3(allData[idxPos], allData[idxPos + 1], allData[idxPos + 2]);
+
+  if ((abs(posXThreshold.x) > Eps && position.x < posXThreshold.x) ||
+      (abs(posXThreshold.y) > Eps && position.x > posXThreshold.y) ||
+      (abs(posYThreshold.x) > Eps && position.y < posYThreshold.x) ||
+      (abs(posYThreshold.y) > Eps && position.y > posYThreshold.y) ||
+      (abs(posZThreshold.x) > Eps && position.z < posZThreshold.x) ||
+      (abs(posZThreshold.y) > Eps && position.z > posZThreshold.y) ||
+      (abs(distThreshold.x - distThreshold.y) < Eps &&
+      abs(length(position) - distThreshold.y) < Eps))
+  {
+    out_data.gPosition = vec4(0.0);
+    gl_Position = vec4(0.0);
+    return;
+  }
+
+  vec2 brightness = vec2(0.0);
+  vec3 velocity = vec3(0.0);
+  if (renderOption != RenderOptionStatic) {
+    int idxCol = firstStarInChunk + nStarsInChunk * 3 + placeInChunk * 2;
+    brightness = vec2(allData[idxCol], allData[idxCol + 1]);
+
+    if ((abs(gMagThreshold.x - gMagThreshold.y) < Eps &&
+         abs(gMagThreshold.x - brightness.x) < Eps) ||
+        (abs(gMagThreshold.x - 20.0) > Eps && brightness.x < gMagThreshold.x) ||
+        (abs(gMagThreshold.y - 20.0) > Eps && brightness.x > gMagThreshold.y) ||
+        (abs(bpRpThreshold.x - bpRpThreshold.y) < Eps &&
+         abs(bpRpThreshold.x - brightness.y) < Eps) ||
+        (abs(bpRpThreshold.x) > Eps && brightness.y < bpRpThreshold.x) ||
+        (abs(bpRpThreshold.y) > Eps && brightness.y > bpRpThreshold.y))
+    {
+      out_data.gPosition = vec4(0.0);
+      gl_Position = vec4(0.0);
+      return;
+    }
+
+    if (renderOption == RenderOptionMotion) {
+      int idxVel = firstStarInChunk + nStarsInChunk * 5 + placeInChunk * 3;
+      velocity = vec3(allData[idxVel], allData[idxVel + 1], allData[idxVel + 2]);
+    }
+  }
+  out_data.brightness = brightness;
+
+  vec4 objectPosition = vec4(position * 1000.0 * Parsec, 1.0);
+  objectPosition.xyz += time * velocity;
+
+  float distPosition = length(objectPosition.xyz / (1000.0 * Parsec));
+  if ((abs(distThreshold.x - distThreshold.y) > Eps &&
+      ((abs(distThreshold.x) > Eps && distPosition < distThreshold.x) ||
+      (abs(distThreshold.y) > Eps && distPosition > distThreshold.y))))
+  {
+    out_data.gPosition = vec4(0.0);
+    gl_Position = vec4(0.0);
+    return;
+  }
+
+  vec4 worldPos = df64_mat4_mul_vec4(
+    model_hi,
+    model_lo,
+    objectPosition.xyz,
+    objectPosition.w
+  );
+  vec4 viewPosition = df64_mat4_mul_vec4(
+    view_hi,
+    view_lo,
+    worldPos.xyz,
+    worldPos.w
+  );
+
+  vec4 sunWorld = df64_mat4_mul_vec4(model_hi, model_lo, vec3(0.0), 1.0);
+  vec4 sunPosition = df64_mat4_mul_vec4(view_hi, view_lo, sunWorld.xyz, sunWorld.w);
+
+  out_data.starDistFromSun = safeLength(objectPosition);
+  out_data.cameraDistFromSun = safeLength(sunPosition);
+
+  if (length(position) > Eps) {
+    out_data.gPosition = worldPos;
+    gl_Position = projection * viewPosition;
+  }
+  else {
+    out_data.gPosition = vec4(0.0);
+    gl_Position = vec4(0.0);
+  }
+}
diff --git a/modules/gaia/shaders/gaia_tonemapping_point_fs_float.glsl b/modules/gaia/shaders/gaia_tonemapping_point_fs_float.glsl
new file mode 100644
index 0000000000..ad7a28b145
--- /dev/null
+++ b/modules/gaia/shaders/gaia_tonemapping_point_fs_float.glsl
@@ -0,0 +1,132 @@
+/*****************************************************************************************
+ *                                                                                       *
+ * OpenSpace                                                                             *
+ *                                                                                       *
+ * Copyright (c) 2014-2026                                                               *
+ *                                                                                       *
+ * Permission is hereby granted, free of charge, to any person obtaining a copy of this  *
+ * software and associated documentation files (the "Software"), to deal in the Software *
+ * without restriction, including without limitation the rights to use, copy, modify,    *
+ * merge, publish, distribute, sublicense, and/or sell copies of the Software, and to    *
+ * permit persons to whom the Software is furnished to do so, subject to the following   *
+ * conditions:                                                                           *
+ *                                                                                       *
+ * The above copyright notice and this permission notice shall be included in all copies *
+ * or substantial portions of the Software.                                              *
+ *                                                                                       *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,   *
+ * INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A         *
+ * PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT    *
+ * HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF  *
+ * CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE  *
+ * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.                                         *
+ ****************************************************************************************/
+
+#include "fragment.glsl"
+
+in Data {
+  vec2 texCoords;
+} in_data;
+
+uniform sampler2D renderedTexture;
+uniform mat4 projection;
+uniform vec2 screenSize;
+uniform int filterSize;
+uniform float sigma;
+uniform float pixelWeightThreshold;
+
+const float M_PI = 3.141592653589793238462;
+const float DefaultDepth = 3.08567758e19; // 1000 Pc
+
+Fragment getFragment() {
+  mat4 proj = projection;
+  float near = proj[3][2] / (proj[2][2] - 1.0);
+  float left = near * (proj[2][0] - 1.0) / proj[0][0];
+  float right = near * (proj[2][0] + 1.0) / proj[0][0];
+  float top = near * (proj[2][1] + 1.0) / proj[1][1];
+  float bottom = near * (proj[2][1] - 1.0) / proj[1][1];
+
+  float xFactor = proj[0][0];
+  float yFactor = proj[1][1];
+
+  float planeAspect = yFactor / xFactor;
+  float screenAspect = screenSize.x / screenSize.y;
+  float fullAspect = planeAspect / screenAspect;
+
+  vec2 screenPos =
+    in_data.texCoords * vec2(right - left, top - bottom) + vec2(left, bottom);
+
+  float beta = atan(length(screenPos) / near);
+  vec2 sigmaScaleFactor = vec2(1.0 / cos(beta), 1.0 / pow(cos(beta), 2.0));
+
+  float defaultScreen = 1200.0;
+  float scaling = screenSize.y / defaultScreen * yFactor;
+
+  vec2 filterScaleFactor = vec2(
+    pow(screenPos.x / near, 2.0) * fullAspect,
+    pow(screenPos.y / near, 2.0)
+  );
+
+  bool useCircleDist = false;
+
+  vec2 newFilterSize = vec2(filterSize) * (1.0 + length(filterScaleFactor)) * scaling;
+
+  float a = 0.0;
+  float b = 0.0;
+  float c = 0.0;
+  if (!useCircleDist) {
+    float alpha = atan(screenPos.y, screenPos.x);
+    float sigmaMajor = sigma * sigmaScaleFactor.y * scaling;
+    float sigmaMinor = sigma * sigmaScaleFactor.x * scaling;
+
+    a = pow(cos(alpha), 2.0) / (2.0 * pow(sigmaMajor, 2.0)) +
+        pow(sin(alpha), 2.0) / (2.0 * pow(sigmaMinor, 2.0));
+    b = sin(2.0 * alpha) / (4.0 * pow(sigmaMajor, 2.0)) -
+        sin(2.0 * alpha) / (4.0 * pow(sigmaMinor, 2.0));
+    c = pow(sin(alpha), 2.0) / (2.0 * pow(sigmaMajor, 2.0)) +
+        pow(cos(alpha), 2.0) / (2.0 * pow(sigmaMinor, 2.0));
+  }
+
+  vec3 intensity = vec3(0.0);
+  vec2 pixelSize = 1.0 / screenSize;
+  ivec2 halfFilterSize = ivec2((newFilterSize - 1.0) / 2.0);
+  for (int y = -halfFilterSize.y; y <= halfFilterSize.y; y++) {
+    for (int x = -halfFilterSize.x; x <= halfFilterSize.x; x++) {
+      vec2 sPoint = in_data.texCoords + (pixelSize * ivec2(x, y));
+
+      float pixelWeight = exp(
+        -(a * pow(x * fullAspect, 2.0) + 2.0 * b * x * y * fullAspect + c * pow(y, 2.0))
+      );
+
+      if (all(greaterThan(sPoint, vec2(0.0))) && all(lessThan(sPoint, vec2(1.0))) &&
+          pixelWeight > pixelWeightThreshold)
+      {
+        vec4 sIntensity = texture(renderedTexture, sPoint);
+
+        if (useCircleDist) {
+          float circleDist = sqrt(pow(x / (1.0 + length(filterScaleFactor)), 2.0) +
+            pow(y / (1.0 + length(filterScaleFactor)), 2.0));
+          intensity += sIntensity.rgb * (1.0 / (sigma * sqrt(2.0 * M_PI))) *
+            exp(-(pow(circleDist, 2.0) / (2.0 * pow(sigma, 2.0)))) / filterSize;
+        }
+        else {
+          intensity += sIntensity.rgb * pixelWeight * fullAspect;
+        }
+      }
+    }
+  }
+
+  intensity = pow(intensity, vec3(0.8));
+
+  if (length(intensity) < 0.01) {
+    discard;
+  }
+
+  Fragment frag;
+  frag.color = vec4(intensity, 1.0);
+  frag.depth = DefaultDepth;
+  frag.gNormal = vec4(0.0, 0.0, 0.0, 1.0);
+  frag.blend = BlendModeNormal;
+
+  return frag;
+}
diff --git a/modules/galaxy/shaders/billboard_gs_float.glsl b/modules/galaxy/shaders/billboard_gs_float.glsl
new file mode 100644
index 0000000000..3000cb5d2a
--- /dev/null
+++ b/modules/galaxy/shaders/billboard_gs_float.glsl
@@ -0,0 +1,133 @@
+/*****************************************************************************************
+ *                                                                                       *
+ * OpenSpace                                                                             *
+ *                                                                                       *
+ * Copyright (c) 2014-2026                                                               *
+ *                                                                                       *
+ * Permission is hereby granted, free of charge, to any person obtaining a copy of this  *
+ * software and associated documentation files (the "Software"), to deal in the Software *
+ * without restriction, including without limitation the rights to use, copy, modify,    *
+ * merge, publish, distribute, sublicense, and/or sell copies of the Software, and to    *
+ * permit persons to whom the Software is furnished to do so, subject to the following   *
+ * conditions:                                                                           *
+ *                                                                                       *
+ * The above copyright notice and this permission notice shall be included in all copies *
+ * or substantial portions of the Software.                                              *
+ *                                                                                       *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,   *
+ * INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A         *
+ * PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT    *
+ * HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF  *
+ * CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE  *
+ * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.                                         *
+ ****************************************************************************************/
+
+#version __CONTEXT__
+
+#include "floatoperations.glsl"
+#include "powerscaling/powerscalingmath.glsl"
+#include "df64.glsl"
+
+layout(points) in;
+in Data {
+  vec3 color;
+} in_data[];
+
+layout(triangle_strip, max_vertices = 4) out;
+out Data {
+  vec4 position;
+  vec2 psfCoords;
+  flat vec3 color;
+  flat float screenSpaceDepth;
+} out_data;
+
+uniform vec3 eyePosition_hi;
+uniform vec3 eyePosition_lo;
+uniform vec3 cameraUp;
+uniform mat4 viewProjectionMatrix_hi;
+uniform mat4 viewProjectionMatrix_lo;
+uniform mat4 modelMatrix_hi;
+uniform mat4 modelMatrix_lo;
+
+const float Parsec = 3.08567756E16;
+
+void main() {
+  out_data.position = gl_in[0].gl_Position;
+  out_data.color = in_data[0].color;
+
+  df64_vec4 dpos = df64_mat4_mul_vec4(
+    modelMatrix_hi,
+    modelMatrix_lo,
+    vec4(out_data.position.xyz * 8.0, out_data.position.w)
+  );
+  dpos.hi.xyz /= Parsec;
+  dpos.lo.xyz /= Parsec;
+
+  vec3 eyeDiff = df64_vec3_sub(eyePosition_hi, eyePosition_lo, dpos.hi.xyz, dpos.lo.xyz);
+  vec3 normal = normalize(eyeDiff);
+  vec3 newRight = normalize(cross(cameraUp, normal));
+  vec3 newUp = cross(normal, newRight);
+  vec3 scaledRight = 32.0 * newRight;
+  vec3 scaledUp = 32.0 * newUp;
+
+  df64_vec4 bl_pos = df64_vec4(
+    dpos.hi - vec4(scaledRight + scaledUp, 0.0),
+    dpos.lo
+  );
+  vec4 bottomLeftVertex = z_normalization(df64_vec4_to_vec4(df64_mat4_mul_df64_vec4(
+    viewProjectionMatrix_hi,
+    viewProjectionMatrix_lo,
+    bl_pos
+  )));
+
+  out_data.screenSpaceDepth = bottomLeftVertex.w;
+
+  df64_vec4 tr_pos = df64_vec4(
+    dpos.hi + vec4(scaledUp + scaledRight, 0.0),
+    dpos.lo
+  );
+  vec4 topRightVertex = z_normalization(df64_vec4_to_vec4(df64_mat4_mul_df64_vec4(
+    viewProjectionMatrix_hi,
+    viewProjectionMatrix_lo,
+    tr_pos
+  )));
+
+  df64_vec4 br_pos = df64_vec4(
+    dpos.hi + vec4(scaledRight - scaledUp, 0.0),
+    dpos.lo
+  );
+  vec4 bottomRightVertex = z_normalization(df64_vec4_to_vec4(df64_mat4_mul_df64_vec4(
+    viewProjectionMatrix_hi,
+    viewProjectionMatrix_lo,
+    br_pos
+  )));
+
+  df64_vec4 tl_pos = df64_vec4(
+    dpos.hi + vec4(scaledUp - scaledRight, 0.0),
+    dpos.lo
+  );
+  vec4 topLeftVertex = z_normalization(df64_vec4_to_vec4(df64_mat4_mul_df64_vec4(
+    viewProjectionMatrix_hi,
+    viewProjectionMatrix_lo,
+    tl_pos
+  )));
+
+  // Build primitive
+  gl_Position = topLeftVertex;
+  out_data.psfCoords = vec2(-1.0, 1.0);
+  EmitVertex();
+
+  gl_Position = bottomLeftVertex;
+  out_data.psfCoords = vec2(-1.0, -1.0);
+  EmitVertex();
+
+  gl_Position = topRightVertex;
+  out_data.psfCoords = vec2(1.0, 1.0);
+  EmitVertex();
+
+  gl_Position = bottomRightVertex;
+  out_data.psfCoords = vec2(1.0, -1.0);
+  EmitVertex();
+
+  EndPrimitive();
+}
